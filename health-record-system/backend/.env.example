PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/health_records
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional — leave SMTP_HOST empty to just log reminder emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@vitalis.demo
